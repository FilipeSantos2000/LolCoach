# Copy to .env and fill in. .env is git-ignored.
# Personal key from https://developer.riotgames.com
RIOT_API_KEY=
# Your server: euw1, eun1, na1, kr, br1, ...
RIOT_PLATFORM=euw1
# Matches to collect per patch (more = better matchup/synergy data).
# Each match costs 2 requests (match + timeline): ~4h for 5000 with a personal key.
META_TARGET_MATCHES=5000
# Optional: League install folder, if not C:\Riot Games\League of Legends
# LEAGUE_PATH=D:\Riot Games\League of Legends
